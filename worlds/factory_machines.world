<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="factory_machines">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Machines include built-in yellow status beacon + front board -->
    <include>
      <uri>model://machine_1</uri>
      <name>machine_1</name>
      <pose>2.5 1.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://machine_2</uri>
      <name>machine_2</name>
      <pose>2.5 -1.5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://machine_3</uri>
      <name>machine_3</name>
      <pose>-2.5 0 0 0 0 0</pose>
    </include>

    <!-- Arena walls -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="c"><pose>0 4 0.25 0 0 0</pose><geometry><box><size>8 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><pose>0 4 0.25 0 0 0</pose><geometry><box><size>8 0.1 0.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="c"><pose>0 -4 0.25 0 0 0</pose><geometry><box><size>8 0.1 0.5</size></box></geometry></collision>
        <visual name="v"><pose>0 -4 0.25 0 0 0</pose><geometry><box><size>8 0.1 0.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="c"><pose>4 0 0.25 0 0 0</pose><geometry><box><size>0.1 8 0.5</size></box></geometry></collision>
        <visual name="v"><pose>4 0 0.25 0 0 0</pose><geometry><box><size>0.1 8 0.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="c"><pose>-4 0 0.25 0 0 0</pose><geometry><box><size>0.1 8 0.5</size></box></geometry></collision>
        <visual name="v"><pose>-4 0 0.25 0 0 0</pose><geometry><box><size>0.1 8 0.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
